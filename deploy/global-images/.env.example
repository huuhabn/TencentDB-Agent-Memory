# =============================================================================
# TDAI local deployment - environment template
# =============================================================================
#
# QUICK START
#   1. cp .env.example .env
#   2. Replace every REPLACE_ME below (section 1 is the only required part)
#   3. ./start-all.sh
#
# Everything outside section 1 has a working default. Change it only if you
# need to.
#
# SECTIONS
#   1. LLM settings (REQUIRED)
#   2. Ports and addresses
#   3. Docker images
#   4. Storage backend (SQLite by default, MongoDB is experimental)
#   5. Credentials and authentication
#   6. Behavior tuning (prompt mode, upload limits, L3 update decision)
# =============================================================================


# =============================================================================
# 1. LLM SETTINGS (REQUIRED)
# =============================================================================
# Two independent groups. Each group has its own URL, key and model, so they
# can use the same LLM or two different providers.
#
#   MEMORY_*  ->  the LLM the system calls internally
#                 (memory embed/summarize, wiki ingest, knowledge summaries)
#   PROXY_*   ->  the LLM your clients' requests are forwarded to
#                 (coding agent -> proxy:8096 -> this LLM)

# --- Group A: internal LLM (memory-core + memory-hub) ------------------------
MEMORY_LLM_BASE_URL=REPLACE_ME              # e.g. https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # e.g. sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # e.g. deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# --- Group B: upstream LLM for forwarded requests (proxy) --------------------
PROXY_UPSTREAM_URL=REPLACE_ME               # e.g. https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # may differ from Group A
PROXY_UPSTREAM_MODEL=REPLACE_ME             # e.g. deepseek-chat


# =============================================================================
# 2. PORTS AND ADDRESSES
# =============================================================================

# --- Host ports --------------------------------------------------------------
# The defaults work as-is. Change them only if a port is already in use.
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# --- Knowledge service address (used by memory-hub) --------------------------
# The address agents and gateways use to reach the Knowledge tools API.
#   - MUST end with /v3 (without it the Panel reports errors)
#   - Default host.docker.internal lets containers reach the host
#   - If you change KNOWLEDGE_PORT, change the port here too
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# --- Proxy address shown in the Panel UI (optional) --------------------------
# Only affects the "client access address" cards in the Panel UI (the base URL
# you copy into CodeBuddy / Claude Code). It does NOT affect how the Panel
# backend talks to memory-core.
#
# Why it exists: in this open-source deployment, clients must connect to the
# proxy, not to memory-core.
#
# Behavior:
#   - Unset: the script detects the host LAN IP and uses
#            http://<lan-ip>:${PROXY_PORT}, so other machines can copy the URL
#   - Set to "": the UI falls back to the old gateway_endpoint behavior
#   - Set to a URL: that URL is used (e.g. a public domain or a specific NIC IP)
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096


# =============================================================================
# 3. DOCKER IMAGES
# =============================================================================
# Default: public Docker Hub images (amd64 + arm64, no login needed):
#   https://hub.docker.com/r/agentmemory/memory-core
#   https://hub.docker.com/r/agentmemory/memory-proxy
#   https://hub.docker.com/r/agentmemory/memory-hub
#
# To pin a version, replace :latest with a version tag, e.g. :1.0.0-beta.1
#
# Note: if an image with the same tag already exists locally, the script
# reuses it and does not check for remote updates.
# To pull the newest image:  PULL=1 ./start-all.sh
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# --- Tencent internal registry (internal colleagues only) --------------------
# Inside the Tencent office network / devcloud, use the private registry
# instead of Docker Hub. Run `docker login mirrors.tencent.com` first, then
# uncomment these three lines.
# MEMORY_CORE_IMAGE=mirrors.tencent.com/memory-team-control/memory-core:latest
# MEMORY_HUB_IMAGE=mirrors.tencent.com/memory-team-control/memory-hub:latest
# PROXY_IMAGE=mirrors.tencent.com/memory-team-control/proxy:latest


# =============================================================================
# 4. STORAGE BACKEND
# =============================================================================

# --- Docker volume names -----------------------------------------------------
# Data persists until you delete the volume. Rename here if needed.
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# --- Memory-core storage mode ------------------------------------------------
# sqlite  (default) Zero dependencies. Data lives in MEMORY_CORE_VOLUME.
#                   Recommended for getting started.
# mongodb (experimental, off by default) Stores L0/L1/profile/skill documents
#                   in MongoDB and uses mongot for BM25 search.
#
# To use MongoDB: do NOT edit the line below. Run ./start-all-mongo.sh instead.
# It writes MEMORY_CORE_STORE_MODE=mongodb into this file and then runs the
# normal start-all.sh flow. After that, ./start-all.sh also stays on MongoDB.
# To go back to SQLite: comment the line out (or set it to sqlite).
#
# Switching backends does NOT migrate existing data.
# MEMORY_CORE_STORE_MODE=mongodb
#
# MongoDB requirements: version 7.0+ with mongot (Atlas or mongodb-atlas-local).
# On first connection, core probes the topology and mongot. If mongot is
# missing, init fails with an error. It does not silently fall back to SQLite.
#
# Choose ONE of the two options below:
#
#   Option A - external MongoDB (Atlas, or a self-hosted replica set with mongot):
# MONGODB_ENDPOINT=mongodb://<YOUR_USER>:<YOUR_PASSWORD>@your-mongo:27017/?directConnection=true
# MONGODB_DATABASE=tdai_memory
#
#   Option B - local container: leave MONGODB_ENDPOINT empty. The script starts
#   a local atlas-local container (mongod + mongot) on the same Docker network.
#   Its data is stored in mongo-local-* volumes and removed by
#   `./stop-all.sh --purge`.
# MONGO_LOCAL_IMAGE=mongodb/mongodb-atlas-local:8.3
# MONGO_LOCAL_CONTAINER=tdai-mongo-local

# --- Metadata backend (teams, users, agents, tasks, ACL) ---------------------
#   auto   (default) Follows MEMORY_CORE_STORE_MODE. In MongoDB mode, metadata
#          goes to the same Mongo, in a separate database
#          (tdai_metadata_<instance>). It uses multi-document transactions, so a
#          replica set is required (the single-node atlas-local one qualifies).
#   sqlite Keep metadata in SQLite inside the core container volume.
# MEMORY_CORE_METADATA_BACKEND=auto
#
# To send metadata to a different Mongo cluster, set its URI here:
# TDAI_METADATA_MONGO_URI=mongodb://<YOUR_USER>:<YOUR_PASSWORD>@other-mongo:27017/


# =============================================================================
# 5. CREDENTIALS AND AUTHENTICATION
# =============================================================================

# --- Gateway Bearer token (memory-core) --------------------------------------
# Empty (default): Bearer auth is OFF. Zero-config for local use, and it is the
#                  only setting where the proxy's auth/sessionInit can connect
#                  to memory-core.
# Non-empty:       every request must send `Authorization: Bearer <key>`.
#                  The proxy does not send this header yet, so the proxy's
#                  auth/sessionInit will FAIL. Do not set this for production
#                  until the proxy side is fixed.
MEMORY_CORE_GATEWAY_API_KEY=

# --- Panel <-> Knowledge service key -----------------------------------------
# Protects the Knowledge write/admin endpoints (wiki ingest, llm-binding/set,
# etc.). Read-only endpoints (tools/*, queries) stay open.
#   Empty (default): the script generates a random ks-svc-* value on first
#                    start and writes it back here, so it stays stable across
#                    restarts. The same value is injected into memory-hub as
#                    KNOWLEDGE_SERVICE_KEY (Knowledge side) and
#                    KNOWLEDGE_AUTH_TOKEN (Panel side).
#   Set manually:    the script keeps your value. Use this when you distribute
#                    the key yourself (multi-machine or external orchestration).
KNOWLEDGE_SERVICE_KEY=

# --- Admin user --------------------------------------------------------------
# Username for the first init-admin. The script generates a random sk-mem- key
# on first start and saves it to ./.admin-key. Later scripts and claude-proxy
# read it from that file, so you never need to enter it manually.
MEMORY_CORE_ADMIN_USERNAME=admin


# =============================================================================
# 6. BEHAVIOR TUNING (all optional)
# =============================================================================

# --- Memory prompt mode ------------------------------------------------------
# Selects the prompt set used by the L1/L2/L3 pipeline.
#   code (default) For coding and team work. Extracts project facts, tasks,
#                  decisions, SOPs and restrictions.
#   chat           For personal chat and teaching. Extracts persona, episodic
#                  and instruction memories.
# Note: in code mode, pure small talk may produce 0 memories. If L1 stays
# empty, check that this mode matches your use case.
MEMORY_PROMPT_MODE=code

# --- Wiki upload size limits -------------------------------------------------
# Panel and Knowledge share this file (same container), so both read these
# values.
#
#   Text files (.md/.txt/.html/.csv, ...)
#     Default 512KB. Allowed range 1KB to 100MB.
# WIKI_TEXT_FILE_MAX_BYTES=524288
#
#   Rich documents (.docx/.xlsx/.pptx/.pdf/.odt, ...)
#     Default 10MB. Allowed range 1KB to 200MB.
# WIKI_BINARY_FILE_MAX_BYTES=10485760
#
#   Per-format override. Takes priority over the two limits above.
#   Format: WIKI_FILE_MAX_BYTES__<EXT>=<bytes>   (extension is case-insensitive)
# WIKI_FILE_MAX_BYTES__PDF=20971520    # PDF up to 20MB
# WIKI_FILE_MAX_BYTES__MD=1048576      # Markdown up to 1MB

# --- L3 instant update decision (JEV) ----------------------------------------
# Controls when the L3 layer (persona / doctrine) is updated.
#   Default (this block commented out): trigger mode is "current". L3 updates
#   when the cumulative L1 count reaches the threshold.
#   With JEV enabled: right after each L2 update, a decision service judges
#   whether L3 should be updated now.
#
# To enable, uncomment ALL lines below. The endpoint, model and key must belong
# to the same decision service.
#   - TokenHub is the default example.
#   - For native TypeSafe, use endpoint https://api.typesafe.ai/v1/systemone
#     and the model name and key supported by that service.
# MEMORY_CORE_PERSONA_TRIGGER_MODE=jev       # current | jev
# MEMORY_CORE_JEV_PROVIDER=jev               # decision provider type (built-in: jev)
# MEMORY_CORE_JEV_ENDPOINT=https://tokenhub.tencentmaas.com/v1/systemone
# MEMORY_CORE_JEV_MODEL=ep-YOUR-SERVICE-ID   # TokenHub model/service ID
# MEMORY_CORE_JEV_TIMEOUT_MS=3000            # Per-call timeout in ms (100 to 60000)
# MEMORY_CORE_JEV_DIAGNOSTICS_MODE=off       # off | metadata | full
#                                            # full logs input text and raw responses.
#                                            # Use it for diagnostics only.
# TYPESAFE_API_KEY=                          # JEV key, read by core from the environment.
#                                            # Never commit a real value.
